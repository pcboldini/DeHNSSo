# MATLAB
*.asv
*.m~
*.mlapp
*.mlx

# MEX binaries (platform-specific — each user builds via mexbuild_*.m)
*.mexa64
*.mexmaci64
*.mexmaca64
*.mexw64
*.mexw32

# Input/output data files
# input/ is generated by gridgen — keep the folder, ignore all its contents
input/*
!input/.gitkeep
# output/ holds saved StabRes results — keep the folder, ignore contents
output/*
!output/.gitkeep
baseflow/output/*
!baseflow/output/benchmark/
# only the three Blasius / swept-wing base flows ship
baseflow/output/benchmark/*
!baseflow/output/benchmark/bf_ts_blasius.mat
!baseflow/output/benchmark/bf_cfi_flat_plate.mat
!baseflow/output/benchmark/bf_ts_compressible.mat
# Local only, NOT shipped: bf_compressible_m006_fine.mat (regenerate with
# papers/DeHNSSo_v2/validation/callers/sec6_4_resonator/baseflow/resonator.m),
# bf_ts_blasius.csv(.gz) and bf_cfi_curved_airfoil.csv. Everything not listed above is ignored.
gridgen/output/*
!gridgen/output/.gitkeep

# Figures
*.fig

# macOS
.DS_Store

# Equation derivations (LaTeX/PDF working notes, not shipped)
docs/equations/

# Paper (manuscript + build, not shipped with the code)
paper/

# Local working notes (not shipped)
CHANGELOG.md

# Tests / validation scripts (dev-only, not shipped)
tests/

# Resonator base-flow caller (local only, not shipped)
baseflow/caller/caller_CBL_resonator.m

# DeHNSSo-v1 replication cases: kept locally, not shipped

# v1 case results are regenerated by their callers; ship inputs and references only
literature/DeHNSSo-v1/*/output/*
!literature/DeHNSSo-v1/*/output/.gitkeep
