baseflow/output/benchmark/*.csv
gridgen/output/

# Figures
*.fig

# macOS
.DS_Store

# Paper build artifacts
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.pdf
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
